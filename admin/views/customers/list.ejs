<%#
  views/customers/list.ejs

  Super-admin marketplace Customers list — the legacy POS customer index
  minus vouchers: live search (name / phone / email / postcode / street /
  city in one box), status filter (All / Active / Banned / Inactive),
  sort, server-side pagination, and per-row actions: About profile,
  Order history, Edit, Ban / Unban, Delete. Reuses the products (.pr-*)
  list styling. `pd` = { customers[], total, this_month, banned, page,
  limit, total_pages, ban_reasons[] } or null.

  Used: Controllers/CustomersController.list.
-%>
<%
    var SORTS = [['newest', 'Newest'], ['oldest', 'Oldest'], ['name_asc', 'Name A–Z'], ['name_desc', 'Name Z–A']];
    var SIZES = [['all', 'All'], ['10', '10'], ['25', '25'], ['50', '50'], ['100', '100'], ['500', '500'], ['1000', '1000']];
    var STATUS_F = [['', 'All status'], ['active', 'Active'], ['banned', 'Banned'], ['inactive', 'Inactive']];
    function pageUrl(n) {
        var qp = [];
        if (search_q) { qp.push('q=' + encodeURIComponent(search_q)); }
        if (cur_status) { qp.push('status=' + encodeURIComponent(cur_status)); }
        qp.push('sort=' + cur_sort); qp.push('limit=' + cur_limit); qp.push('page=' + n);
        return '/customers?' + qp.join('&');
    }
    var page = pd ? Number(pd.page) : 1;
    var totalPages = pd ? Number(pd.total_pages) : 1;
%>
<div class="pr" data-cu-root>

    <div class="ly__head">
        <div>
            <h2 class="ly__title">🧑 Customers</h2>
            <p class="ly__sub"><%= (pd && pd.marketplace === false) ? 'This restaurant\'s customers' : 'All marketplace customers' %>
                <% if (pd) { %> · <strong><%= pd.total %></strong> total · <strong><%= pd.this_month %></strong> joined this month · <strong><%= pd.banned %></strong> banned<% } %>
            </p>
        </div>
    </div>

    <% if (load_error) { %>
        <div class="ly-empty"><span class="ly-empty__ic" aria-hidden="true">🧑</span><p class="ly-empty__msg"><%= load_error %></p></div>
    <% } else if (pd) { %>

        <div class="pr-toolbar">
            <form method="get" action="/customers" class="pr-filter" id="pr-filter">
                <div class="pr-search">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" name="q" value="<%= search_q %>" placeholder="Search name, phone, email, postcode, street…" autocomplete="off" data-live-search>
                    <% if (search_q) { %><a href="/customers" class="pr-search__clear" aria-label="Clear">✕</a><% } %>
                </div>
                <%# Mobile-only: open the filters sheet %>
                <button type="button" class="pr-filterbtn" data-filter-toggle aria-label="Filters" title="Filters">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    <% if (cur_status || (cur_sort && cur_sort !== 'newest')) { %><span class="pr-filterbtn__dot"></span><% } %>
                </button>
                <div class="pr-filters" data-filters>
                    <div class="pr-filters__head"><span class="pr-filters__ttl">Filters</span><button type="button" class="pr-filters__x" data-filter-close aria-label="Close">✕</button></div>
                    <select name="status" class="pr-filter-sel" data-filter-submit aria-label="Status">
                        <% STATUS_F.forEach(function (s) { %><option value="<%= s[0] %>" <%= cur_status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }); %>
                    </select>
                    <select name="sort" class="pr-filter-sel" data-filter-submit aria-label="Sort">
                        <% SORTS.forEach(function (s) { %><option value="<%= s[0] %>" <%= cur_sort === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }); %>
                    </select>
                    <select name="limit" class="pr-filter-sel" data-filter-submit aria-label="Per page">
                        <% SIZES.forEach(function (s) { %><option value="<%= s[0] %>" <%= cur_limit === s[0] ? 'selected' : '' %>>Show <%= s[1] %></option><% }); %>
                    </select>
                    <button type="button" class="ly-btn ly-btn--primary pr-filters__done" data-filter-close>Done</button>
                </div>
            </form>
        </div>
        <div class="pr-filters__backdrop" data-filter-backdrop hidden></div>

        <% if (!pd.customers.length) { %>
            <div class="ly-empty"><span class="ly-empty__ic" aria-hidden="true">🧑</span><p class="ly-empty__msg"><%= (search_q || cur_status) ? 'No customers match your filters.' : 'No customers yet.' %></p></div>
        <% } else { %>
        <div class="pr-list" data-list>
            <% pd.customers.forEach(function (c) { %>
            <div class="pr-item cu-item" data-id="<%= c.id %>" data-name="<%= c.name %>">
                <div class="pr-item__main">
                    <span class="pr-item__img cu-avatar" aria-hidden="true"><%= (c.firstname || '?').charAt(0).toUpperCase() %></span>
                    <span class="pr-item__name">
                        <%= c.name || ('Customer #' + c.id) %>
                        <% if (c.status === '3') { %><span class="cu-badge cu-badge--banned" title="<%= c.banned_reason === 'Other' ? c.other_banned_reason : c.banned_reason %>">Banned</span><% } %>
                        <% if (c.status === '0') { %><span class="cu-badge cu-badge--off">Inactive</span><% } %>
                        <span class="cu-sub">
                            <% if (c.contact_no) { %><span>📞 <%= c.contact_no %></span><% } %>
                            <% if (c.email) { %><span>✉️ <%= c.email %></span><% } %>
                            <% if (c.address) { %><span>📍 <%= c.address %></span><% } %>
                        </span>
                    </span>
                </div>
                <div class="pr-item__controls">
                    <span class="cu-orders" title="Marketplace orders"><%= c.total_orders %> order<%= c.total_orders === 1 ? '' : 's' %></span>
                    <span class="pr-item__act">
                        <a href="/customers/history/<%= c.id %>" class="ly-iconbtn" title="Order history">🧾</a>
                        <a href="/customers/edit/<%= c.id %>" class="ly-iconbtn" title="Edit">✎</a>
                        <% if (c.status === '3') { %>
                        <button type="button" class="ly-iconbtn" data-action="cu-unban" data-id="<%= c.id %>" data-name="<%= c.name %>" title="Unban">♻️</button>
                        <% } else { %>
                        <button type="button" class="ly-iconbtn" data-action="cu-ban" data-id="<%= c.id %>" data-name="<%= c.name %>" title="Ban">🚫</button>
                        <% } %>
                        <button type="button" class="ly-iconbtn ly-iconbtn--danger" data-action="cu-delete" data-id="<%= c.id %>" data-name="<%= c.name %>" title="Delete">🗑</button>
                    </span>
                </div>
            </div>
            <% }); %>
        </div>

        <% if (totalPages > 1 || pd.total) { %>
        <div class="pr-pager">
            <span class="pr-pager__info"><%= pd.total %> customer<%= pd.total === 1 ? '' : 's' %><% if (totalPages > 1) { %> · page <%= page %> of <%= totalPages %><% } %></span>
            <% if (totalPages > 1) { %>
            <div class="pr-pager__nav">
                <% if (page > 1) { %><a class="pr-pager__btn" href="<%= pageUrl(page - 1) %>">‹ Prev</a><% } else { %><span class="pr-pager__btn is-disabled">‹ Prev</span><% } %>
                <% var from = Math.max(1, page - 2), to = Math.min(totalPages, page + 2);
                   if (from > 1) { %><a class="pr-pager__btn" href="<%= pageUrl(1) %>">1</a><% if (from > 2) { %><span class="pr-pager__dots">…</span><% } } %>
                <% for (var n = from; n <= to; n++) { %><a class="pr-pager__btn <%= n === page ? 'is-active' : '' %>" href="<%= pageUrl(n) %>"><%= n %></a><% } %>
                <% if (to < totalPages) { if (to < totalPages - 1) { %><span class="pr-pager__dots">…</span><% } %><a class="pr-pager__btn" href="<%= pageUrl(totalPages) %>"><%= totalPages %></a><% } %>
                <% if (page < totalPages) { %><a class="pr-pager__btn" href="<%= pageUrl(page + 1) %>">Next ›</a><% } else { %><span class="pr-pager__btn is-disabled">Next ›</span><% } %>
            </div>
            <% } %>
        </div>
        <% } %>
        <% } %>

    <% } %>
</div>

<%# Delete confirm modal — soft delete (status 2). %>
<div class="pr-modal" data-modal="cu-delete" hidden>
    <div class="pr-modal__panel pr-modal__panel--sm">
        <div class="pr-modal__icon">⚠️</div>
        <h3 class="pr-modal__title">Are you sure?</h3>
        <p class="pr-modal__msg" data-delete-msg>Delete this customer?</p>
        <div class="pr-modal__foot pr-modal__foot--center">
            <button type="button" class="ly-btn ly-btn--ghost" data-action="pr-modal-cancel">No, cancel</button>
            <button type="button" class="ly-btn ly-btn--danger" data-action="cu-delete-confirm">Yes, delete</button>
        </div>
    </div>
</div>

<%# Ban modal — legacy reason dropdown; "Other" reveals the text box. %>
<div class="pr-modal" data-modal="cu-ban" hidden>
    <div class="pr-modal__panel pr-modal__panel--sm">
        <div class="pr-modal__icon">🚫</div>
        <h3 class="pr-modal__title">Ban customer</h3>
        <p class="pr-modal__msg" data-ban-msg>Ban this customer?</p>
        <select class="pr-filter-sel cu-ban__reason" data-ban-reason aria-label="Ban reason">
            <option value="">Select a reason…</option>
            <% ((pd && pd.ban_reasons) || []).forEach(function (rn) { %><option value="<%= rn %>"><%= rn %></option><% }); %>
        </select>
        <input type="text" class="cu-ban__other" data-ban-other placeholder="Other reason…" maxlength="255" hidden>
        <div class="pr-modal__foot pr-modal__foot--center">
            <button type="button" class="ly-btn ly-btn--ghost" data-action="pr-modal-cancel">Cancel</button>
            <button type="button" class="ly-btn ly-btn--danger" data-action="cu-ban-confirm">Ban customer</button>
        </div>
    </div>
</div>
